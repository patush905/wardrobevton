# Copy to .env and fill in. .env is gitignored - keep it that way.

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard > Project Settings > Database > Connection string > Transaction pooler
# Change the postgresql:// prefix to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Dashboard > Project Settings > API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key - server side only>
SUPABASE_JWT_SECRET=<JWT secret>
STORAGE_BUCKET=wardrobe
SIGNED_URL_TTL=900

# ── Try-on provider ─────────────────────────────────────────────────────────
# mock        -> placeholder image, no GPU. Build the whole website on this.
# modal_leffa -> your deployed Modal endpoint
# hf_space    -> public Hugging Face Space (fallback)
VTON_PROVIDER=mock
VTON_MODEL_VERSION=mock-0.1

MODAL_ENDPOINT_URL=
MODAL_CALLBACK_SECRET=

HF_SPACE_ID=franciszzj/Leffa
HF_TOKEN=

# ── Local dev only ──────────────────────────────────────────────────────────
DEV_AUTH_BYPASS=true
